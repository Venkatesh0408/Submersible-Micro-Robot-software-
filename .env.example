# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Security Configuration
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="100"
LOG_LEVEL="info"

# ---- Supabase Auth ----
# From your Supabase project -> Project Settings -> API.
# VITE_* is bundled into the client; the anon key is public/safe to expose.
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# ---- Hugging Face (image-to-3D) ----
# SERVER-SIDE ONLY. No VITE_ prefix, so it is never exposed to the browser.
# Read only by the Express /api/generate-3d endpoint.
HF_API_TOKEN="YOUR_HUGGINGFACE_TOKEN"

# ---- Resend (auth email SMTP) ----
# NOT read by this app. Configure inside the Supabase dashboard:
# Authentication -> Emails -> SMTP: host smtp.resend.com, port 465, user "resend",
# password = your Resend API key, sender = your verified domain.
# RESEND_API_KEY="YOUR_RESEND_API_KEY"
